diff --git a/src/planner/plan_env/include/plan_env/reference_geometry.h b/src/planner/plan_env/include/plan_env/reference_geometry.h
new file mode 100644
index 0000000..ee4a748
--- /dev/null
+++ b/src/planner/plan_env/include/plan_env/reference_geometry.h
@@ -0,0 +1,28 @@
+#pragma once
+#include <Eigen/Core>
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <vector>
+namespace scan_reference {
+struct Geometry {
+  std::vector<Eigen::Vector4d> poses;
+  Eigen::Vector4d project(const Eigen::Vector3d& point, double fallback=0.) const {
+    double best=std::numeric_limits<double>::infinity();
+    Eigen::Vector4d result(point.x(),point.y(),point.z(),fallback);
+    for(size_t i=0;i<poses.size();++i) {
+      const Eigen::Vector3d a=poses[i].head<3>();
+      const double distance=(point-a).squaredNorm();
+      if(distance<best){best=distance;result=poses[i];}
+      if(i+1==poses.size())continue;
+      const Eigen::Vector3d v=poses[i+1].head<3>()-a;
+      if(v.squaredNorm()<1e-8)continue;
+      const double t=std::clamp((point-a).dot(v)/v.squaredNorm(),0.,1.);
+      const double d=(point-a-t*v).squaredNorm();
+      if(d<best){best=d;result.head<3>()=a+t*v;result[3]=poses[i][3]+t*std::remainder(poses[i+1][3]-poses[i][3],2*M_PI);}
+    }
+    return result;
+  }
+  double yawAt(const Eigen::Vector3d& point,double fallback) const {return project(point,fallback)[3];}
+};
+}
diff --git a/src/planner/plan_env/include/plan_env/se2_corridor.h b/src/planner/plan_env/include/plan_env/se2_corridor.h
