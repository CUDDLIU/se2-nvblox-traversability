@@ -0,0 +1,32 @@
+#pragma once
+#include <Eigen/Core>
+#include <algorithm>
+#include <limits>
+#include <cmath>
+#include <vector>
+namespace scan_reference {
+// Penalize deviation of the actual cubic curve, not its control polygon.
+// Spatial guidance must survive the native time-refinement optimization.
+inline double curveCost(const Eigen::MatrixXd& control,
+                        const std::vector<Eigen::Vector3d>& route,
+                        Eigen::MatrixXd& gradient) {
+  gradient=Eigen::MatrixXd::Zero(3,control.cols());
+  if(route.size()<2)return 0.;
+  double cost=0.;
+  for(int i=0;i+3<control.cols();++i)for(int sample=0;sample<4;++sample) {
+    const double t=sample*.25,t2=t*t,t3=t2*t;
+    const Eigen::Vector4d w(std::pow(1-t,3)/6.,(3*t3-6*t2+4)/6.,(-3*t3+3*t2+3*t+1)/6.,t3/6.);
+    const Eigen::Vector3d point=control.middleCols(i,4)*w;
+    double best=std::numeric_limits<double>::infinity();Eigen::Vector3d delta=Eigen::Vector3d::Zero();
+    for(size_t j=1;j<route.size();++j){
+      const Eigen::Vector3d v=route[j]-route[j-1];
+      const double u=std::clamp((point-route[j-1]).dot(v)/std::max(1e-12,v.squaredNorm()),0.,1.);
+      const Eigen::Vector3d d=point-route[j-1]-u*v;
+      if(d.squaredNorm()<best){best=d.squaredNorm();delta=d;}
+    }
+    cost+=.25*best;
+    for(int j=0;j<4;++j)gradient.col(i+j)+=.5*w[j]*delta;
+  }
+  return cost;
+}
+}
