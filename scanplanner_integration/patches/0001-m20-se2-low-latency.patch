+namespace scan_planner {
+// Splice measured progress into an ordered 3-D reference. Never select an
+// arbitrary nearest future segment across a folded route or another floor.
+inline std::vector<Eigen::Vector3d> remainingReference(
+    const Eigen::Vector3d& start, const std::vector<Eigen::Vector3d>& reference) {
+  std::vector<Eigen::Vector3d> route{start};
+  size_t first = 0;
+  while (first + 1 < reference.size()) {
+    const Eigen::Vector3d v = reference[first + 1] - reference[first];
+    const double squared = v.squaredNorm();
