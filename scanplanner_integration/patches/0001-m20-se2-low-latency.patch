+double AStar::corridorCost(const Vector3d& a, const Vector3d& b) const {
+    if (corridor_weight_ <= 0. || grid_map_->se2_corridor.regions.empty() ||
+        grid_map_->body_reference.poses.empty()) return 0.;
+    double cost = 0.;
+    for (double u : {0., .5, 1.}) {
+        Vector3d p = a + u * (b - a);
