+        p.z() = surface.z();
+        Vector2d delta;
+        cost += grid_map_->se2_corridor.distance(p, surface[3], delta)
+                    ? delta.squaredNorm() : 1.;
+    }
+    return corridor_weight_ * cost / 3.;
+}
