index 0000000..8cb5c84
--- /dev/null
+++ b/src/planner/plan_env/include/plan_env/se2_corridor.h
@@ -0,0 +1,92 @@
+#pragma once
+#include <plan_env/reference_geometry.h>
+#include <Eigen/Core>
+#include <algorithm>
+#include <cstdint>
+#include <limits>
+#include <numeric>
+#include <vector>
+namespace scan_reference {
+struct Region {
+  double z;uint64_t mask;std::vector<Eigen::Vector2d> vertices;
+  Eigen::Vector2d low,high;
+  Eigen::Vector2d displacement(const Eigen::Vector2d& p) const {
+    if(vertices.size()==1)return p-vertices[0];
+    bool positive=false,negative=false;double best=std::numeric_limits<double>::infinity();Eigen::Vector2d delta;
+    for(size_t i=0;i<vertices.size();++i){
+      const auto& a=vertices[i];const Eigen::Vector2d v=vertices[(i+1)%vertices.size()]-a;
+      const double cross=v.x()*(p.y()-a.y())-v.y()*(p.x()-a.x());positive|=cross>1e-10;negative|=cross< -1e-10;
+      const double t=std::clamp((p-a).dot(v)/std::max(1e-12,v.squaredNorm()),0.,1.);
+      const Eigen::Vector2d d=p-a-t*v;if(d.squaredNorm()<best){best=d.squaredNorm();delta=d;}
+    }
+    return !(positive&&negative) ? Eigen::Vector2d::Zero().eval() : delta;
+  }
+};
+struct Corridor {
+  double stamp=0,max_step=.2;int bins=40;std::vector<Region> regions;
+  struct Node {Eigen::Vector2d low,high;double zlow,zhigh;uint64_t mask=0;int begin,end,left=-1,right=-1;};
+  std::vector<Node> nodes;std::vector<int> order;
+  static double boxDistance(const Eigen::Vector2d& p,const Eigen::Vector2d& lo,const Eigen::Vector2d& hi){
+    return (p-p.cwiseMax(lo).cwiseMin(hi)).squaredNorm();
+  }
+  int build(int begin,int end){
+    Node n;n.begin=begin;n.end=end;n.low=Eigen::Vector2d::Constant(std::numeric_limits<double>::infinity());n.high=-n.low;
