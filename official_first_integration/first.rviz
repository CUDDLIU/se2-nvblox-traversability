Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Enabled: true
  Global Options:
    Background Color: 25; 29; 35
    Fixed Frame: se2_scan_map
    Frame Rate: 20
  Displays:
  - Class: rviz_default_plugins/MarkerArray
    Name: 完整 bag Mesh（可选，选点时关闭）
    Enabled: false
    Topic:
      Value: /se2_global/mesh
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 1
  - Class: rviz_default_plugins/MarkerArray
    Name: 全局可通行图 · 绿 / 橙
    Enabled: true
    Topic:
      Value: /se2_global/traversability
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 1
  - Class: rviz_default_plugins/MarkerArray
    Name: SE(2) 多边形边界（可选）
    Enabled: false
    Topic:
      Value: /se2_global/polygons
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 1
  - Class: rviz_default_plugins/MarkerArray
    Name: 全局路径 · 黄色 / 朝向箭头
    Enabled: true
    Topic:
      Value: /se2_global/path_markers
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 1
  - Class: rviz_default_plugins/MarkerArray
    Name: 起点 · 青色 / 目标 · 粉色
    Enabled: true
    Topic:
      Value: /se2_global/query_markers
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 1
  - Class: rviz_default_plugins/Grid
    Name: Reference grid
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 40
  - Class: rviz_default_plugins/Path
    Name: FIRST 局部轨迹
    Enabled: true
    Topic:
      Value: /first/local_path
      Depth: 1
      Durability Policy: Volatile
      Reliability Policy: Reliable
    Color: 0; 210; 255
    Line Style: Lines
    Line Width: 0.04
  - Class: rviz_default_plugins/PointCloud2
    Name: FIRST 局部规划障碍点云
    Enabled: true
    Topic:
      Value: /first/planning_obstacles
      Depth: 1
      Reliability Policy: Best Effort
      Durability Policy: Volatile
    Size (Pixels): 3
    Style: Points
    Color Transformer: FlatColor
    Color: 255; 100; 70
    Alpha: 1
    Decay Time: 0
  - Class: rviz_default_plugins/RobotModel
    Name: M20 实测姿态模型
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /first/robot_description
      Depth: 1
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Visual Enabled: true
    Collision Enabled: false
    Alpha: 1
    Update Interval: 0
    TF Prefix: ''
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/PublishPoint
    Topic:
      Value: /clicked_point
    Single click: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Near Clip Distance: 0.01
      Distance: 36
      Pitch: 0.6
      Yaw: 0.2
      Target Frame: <Fixed Frame>
      Focal Point:
        X: 0
        Y: -9
        Z: 2.5
Window Geometry:
  Width: 1280
  Height: 720
  X: 100
  Y: 70
