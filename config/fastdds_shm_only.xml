<?xml version="1.0" encoding="UTF-8"?>
<!-- Local shadow participants only.  The crop/audit nodes keep the normal
     UDP+SHM profile because they subscribe to the cross-host raw LiDAR. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>m20_shadow_shm_only</transport_id>
      <type>SHM</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="m20_shadow_shm_only" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports>
        <transport_id>m20_shadow_shm_only</transport_id>
      </userTransports>
    </rtps>
  </participant>
</profiles>
